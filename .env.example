# 复制为 .env 后仅用于本地实验；Compose 会自动读取同目录的 .env。
# 生产环境不要把真实密码提交到 Git，应使用 systemd EnvironmentFile、Docker Secret 或密钥管理系统。

# 写入镜像标签、Actuator info 和 Prometheus 公共标签，便于识别运行版本。
APP_VERSION=0.3.0-local

# 应用账户连接 MySQL 的密码，必须与 Compose 中 MYSQL_PASSWORD/DB_PASSWORD 保持一致。
DB_PASSWORD=replace_with_a_strong_password

# MySQL root 仅用于数据库初始化与管理，不应提供给应用进程。
MYSQL_ROOT_PASSWORD=replace_with_another_strong_password

# Redis 同时保存共享会话与可重建总览缓存；建议使用 24 位以上随机字母数字组合。
# 本地只绑定 127.0.0.1，生产还应使用平台 Secret、私网与 TLS。
REDIS_PASSWORD=replace_with_a_strong_redis_password

# 仅在全新数据库中创建一次管理员；创建完成后应用不会覆盖同名用户密码。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_12_character_password
BOOTSTRAP_ADMIN_DISPLAY_NAME=Local Administrator

# Grafana 管理员初始密码；首次登录后也应改为受控的真实密码。
GRAFANA_ADMIN_PASSWORD=replace_with_a_grafana_password
