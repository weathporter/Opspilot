# systemd 原生部署的环境变量模板。
# 安装后复制到 /etc/opspilot/opspilot.env，并设置 root:opspilot 0640：
# root 可修改，opspilot 服务组可读，其他本机用户无权读取数据库密码。

# 业务环境和版本会写入 Actuator info 与 Prometheus 标签，便于区分生产/测试及定位发布版本。
APP_ENV=production
APP_VERSION=0.3.0

# Java 只监听本机回环地址，由同机 Nginx 对外提供 80 端口，避免绕过代理直接访问 Actuator。
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18080

# DB_HOST/PORT/NAME 供备份恢复脚本读取；DB_URL 供 Spring Boot JDBC 直接使用。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=opspilot
DB_URL=jdbc:mysql://127.0.0.1:3306/opspilot?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false

# 应用应使用最小权限数据库账号，不应使用 MySQL root。
DB_USERNAME=opspilot
DB_PASSWORD=CHANGE_ME

# Redis 保存共享会话和总览缓存；同机实例使用 127.0.0.1，外部平台实例填写私网 DNS。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=CHANGE_ME
REDIS_CONNECT_TIMEOUT=1s
REDIS_TIMEOUT=1s
# 故障演练脚本默认操作 redis.service；发行版名称不同才显式覆盖为 redis-server。
REDIS_SYSTEMD_SERVICE=redis

# 全新数据库首次启动前填写；用户表已有数据后，应用不会用这些值覆盖现有管理员。
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator

# 当前模板的 Nginx 只监听 HTTP；配置 TLS 后必须改为 true，防止会话 Cookie 经明文连接传输。
SESSION_COOKIE_SECURE=false

# 原生部署写固定日志文件，由 /etc/logrotate.d/opspilot 定期轮转，防止磁盘被日志写满。
LOG_FILE=/var/log/opspilot/application.log

# JVM 最大使用容器/主机可见内存的约 75%；OOM 时退出，由 systemd 按失败策略重启。
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
